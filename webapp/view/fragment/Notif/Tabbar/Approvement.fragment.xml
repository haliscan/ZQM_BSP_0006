<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns:upload="sap.m.upload"
>
    <FlexBox
        direction="Column"
        width="300px"
    >
        <FlexBox
            direction="Row"
            visible="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Approvement/Decision'], formatter: '.formatter.SetVisibleTaskStatu'}"
        >
            <Label
                class="sapUiTinyMarginTop"
                text="{i18n>Decision}"
                width="55px"
            />
            <ComboBox
                items="{path: '/ShTaskOnaySet', templateShareable: false}"
                selectedKey="{viewModel>/Approvement/Decision}"
                editable="false"
                width="50%"
            >
                <core:ListItem
                    key="{Code}"
                    text="{Description}"
                />
            </ComboBox>
        </FlexBox>

        <FlexBox
            direction="Column"
            visible="{= ${viewModel>/Header/Mncod} === '1003' }"
        >
            <FlexBox direction="Row">
                <Label
                    class="sapUiTinyMarginTop"
                    text="{i18n>OkMenge}"
                    width="100px"
                    showColon="true"
                />
                <Input
                    id="IdOkMenge"
                    value="{viewModel>/Approvement/OkMenge}"
                    type="Number"
                    required="true"
                    editable="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Approvement/Decision'], formatter: '.formatter.SetEditableQty'}"
                    change="onChangeInputMenge"
                />
            </FlexBox>

            <FlexBox direction="Row">
                <Label
                    class="sapUiTinyMarginTop"
                    text="{i18n>NokMenge}"
                    width="100px"
                    showColon="true"
                />
                <Input
                    id="IdNokMenge"
                    value="{viewModel>/Approvement/NokMenge}"
                    type="Number"
                    required="true"
                    editable="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Approvement/Decision'], formatter: '.formatter.SetEditableQty'}"
                    change="onChangeInputMenge"
                />
            </FlexBox>
        </FlexBox>

        <FlexBox direction="Row">
            <TextArea
                id="IdApprovementDescr"
                value="{viewModel>/Approvement/Descr}"
                placeholder="{i18n>RequiredDescr}"
                cols="50"
                rows="5"
                required="true"
                editable="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Approvement/Decision'], formatter: '.formatter.SetEditableDescr'}"
                change="onChangeInput"
            />
        </FlexBox>

        <FlexBox
            direction="Row"
            alignContent="End"
            justifyContent="End"
        >
            <Button
                press="onApprove"
                class="sapUiSmallMarginEnd"
                text="{i18n>Approve}"
                type="Accept"
                visible="{ parts:['viewModel>/Header/Qmart','viewModel>/Auth/Authenticated','viewModel>/Header/Mncod','viewModel>/Approvement/Decision','viewModel>/IsSupplier'], formatter: '.formatter.SetVisibleApproveAction'}"
            />
            <Button
                press="onReject"
                class="sapUiSmallMarginEnd"
                text="{i18n>Reject}"
                type="Reject"
                visible="{ parts:['viewModel>/Header/Qmart','viewModel>/Auth/Authenticated','viewModel>/Header/Mncod','viewModel>/Approvement/Decision','viewModel>/IsSupplier'], formatter: '.formatter.SetVisibleApproveAction'}"
            />
            <Button
                press="onSave"
                class="sapUiSmallMarginEnd"
                text="{i18n>Save}"
                type="Emphasized"
                visible="{ parts:['viewModel>/Header/Qmart','viewModel>/Auth/Authenticated','viewModel>/Header/Mncod','viewModel>/Approvement/Decision','viewModel>/IsSupplier'], formatter: '.formatter.SetVisibleSaveAction'}"
            />
        </FlexBox>

        <FlexBox
            direction="Row"
            alignContent="Start"
            justifyContent="Start"
        >
            <upload:UploadSet
                id="IdAttaUploader"
                items="{viewModel>/Attachment}"
                instantUpload="false"
                mode="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Header/Mncod','viewModel>/Approvement/Decision'], formatter: '.formatter.SetEditableAttaMode'}"
                beforeUploadStarts="onBeforeAttUpload"
                afterItemRemoved="onRemoveAttItem"
                uploadCompleted="onComplAttUpload"
                uploadEnabled="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Header/Mncod','viewModel>/Approvement/Decision'], formatter: '.formatter.SetEditableAtta'}"
            >
                <upload:items>
                    <upload:UploadSetItem
                        url="{viewModel>Url}"
                        fileName="{viewModel>OrjFileName}"
                        mediaType="{viewModel>DocType}"
                        visibleEdit="false"
                        enabledEdit="false"
                        visibleRemove="{ parts:['viewModel>/Auth/Authenticated','viewModel>/Header/Mncod','viewModel>/Approvement/Decision'], formatter: '.formatter.SetEditableAtta'}"
                    />
                </upload:items>
            </upload:UploadSet>
        </FlexBox>
    </FlexBox>
</core:FragmentDefinition>
